# Google Gemini API Key (Get a free key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Default model: gemini-3-flash-preview (recommended)
GEMINI_MODEL=gemini-3-flash-preview

# Server Port (assigned automatically by cloud hosts like Render/Railway/Fly.io)
PORT=3000

# Optional: Directory for cached cloned repositories (defaults to .repos_cache)
# REPOS_CACHE_DIR=/tmp/.repos_cache
